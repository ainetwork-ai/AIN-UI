{
  "name": "ain-ui",
  "version": "1.0.4",
  "description": "AIN-UI: A2UI 1.0 components, renderers and agent tools \u2014 standard catalog, files, uploads and x402 payments",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainetwork-ai/AIN-UI.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    },
    "./styles.css": "./dist/styles.css",
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js",
      "default": "./dist/x402.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./macros": {
      "types": "./dist/macros.d.ts",
      "import": "./dist/macros.js",
      "default": "./dist/macros.js"
    },
    "./catalog-v1.json": "./dist/catalog-v1.json"
  },
  "scripts": {
    "build": "node scripts/standard.mjs && tsc && node scripts/styles.mjs && node scripts/catalog.mjs",
    "test": "node scripts/standard.mjs && tsx --test test/*.test.ts test/*.test.tsx",
    "prepublishOnly": "npm run build && npm test",
    "generate": "node scripts/standard.mjs",
    "test:built": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@a2ui/agent": "^0.2.1",
    "@a2ui/markdown-it": "^0.2.4",
    "@a2ui/react": "^0.16.1",
    "@a2ui/web_core": "^0.16.1",
    "@x402/core": "~2.14.0",
    "@x402/evm": "~2.14.0",
    "lucide": "^1.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "katex": "^0.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "ain-ui",
  "version": "0.2.0",
  "description": "AIN-UI: A2UI and AG-UI extensions for grids, files, uploads and x402 payments",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainetwork-ai/AIN-UI.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    },
    "./styles.css": "./dist/styles.css",
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js",
      "default": "./dist/x402.js"
    },
    "./catalog.json": "./dist/catalog.json"
  },
  "scripts": {
    "build": "tsc && cp src/styles.css dist/styles.css && node scripts/catalog.mjs",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@a2ui/react": "0.11.1",
    "@a2ui/web_core": "0.11.0",
    "@x402/core": "~2.14.0",
    "@x402/evm": "~2.14.0",
    "zod": "^3.25.76",
    "@a2ui/markdown-it": "0.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
